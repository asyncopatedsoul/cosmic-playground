# Copy to .env.itch (git-ignored) for `npm run itch` (docs/PUBLISHING-ITCH.md §6.1).
# The same three values are repository variables for .github/workflows/itch.yml.

# The itch project butler pushes to: <user>/<game>
ITCH_TARGET=your-user/cosmic-playground

# The always-on relay (apps/relay/server.mjs on Render), baked into every build
VITE_RELAY_URL=wss://cosmic-relay.onrender.com

# The page testers open; invites say "Go to <this> and enter code K7QFZM"
VITE_SHARE_URL=https://your-user.itch.io/cosmic-playground
