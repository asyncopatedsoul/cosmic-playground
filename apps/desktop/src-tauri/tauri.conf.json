{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cosmic Playground",
  "version": "0.1.0",
  "identifier": "app.cosmicplayground.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../../playground/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cosmic Playground",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "userAgent": "CosmicPlayground/0.1 (Tauri; WebView)"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
