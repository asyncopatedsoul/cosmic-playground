      "t_voiceA": { "all": "lock", "move": true,
        "pattern": { "template": "<[{a} . {a} .] [{b} . {b} .]>", "holes": { "a": { "values": [0, 1, 2, 3, 4, 5, 6], "start": 1 }, "b": { "values": [0, 1, 2, 3, 4, 5, 6], "start": 1 } } } },
      "t_voiceB": { "all": "lock", "move": true,
        "pattern": { "template": "<[. {a} . {a}] [. {b} . {b}]>", "holes": { "a": { "values": [0, 1, 2, 3, 4, 5, 6], "start": 6 }, "b": { "values": [0, 1, 2, 3, 4, 5, 6], "start": 6 } } } },
