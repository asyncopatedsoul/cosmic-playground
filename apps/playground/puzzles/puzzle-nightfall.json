        "pattern": "<[0 . 0 0] [3 . 3 3]>", "pulse": { "enabled": true, "steps": 16, "stepsPerBeat": 2 } },
      { "id": "t_voiceA", "entry": "singing-bowl", "pos": [-1.3, 0, 3.0], "params": { "rim": 0.0854, "glaze": 1 },
