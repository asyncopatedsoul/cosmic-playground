      { "id": "t_voiceB", "entry": "pendulum-clock", "pos": [1.5, 0, 3.0], "params": { "length": 0.534, "tick": 0.25 }, "reveal": "voiceA",
        "pulse": { "enabled": true, "steps": 16, "stepsPerBeat": 2 } },
      { "id": "t_lanterns", "entry": "orrery", "pos": [3.6, 0, -0.6], "params": { "p0": 0.6, "p1": 0, "p2": 0, "p3": 0, "speed": 1 }, "reveal": "voiceB", "volume": 0.5 }
    ]
  },
  "rules": {
    "world": { "tempo": "lock", "tuning": "lock", "chest": [] },
